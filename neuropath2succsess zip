js_content = """
function suggestHabits() {
    const input = document.getElementById("goal").value.toLowerCase();
    const output = document.getElementById("suggestions");
    output.innerHTML = "";

    const habits = {
        focus: ["Pomodoro technique", "Digital detox hour", "Morning planning ritual"],
        stress: ["Deep breathing", "Nature walk", "Gratitude journaling"],
        energy: ["Cold shower", "High-protein breakfast", "10-min jumpstart workout"]
    };

    let found = false;
    for (let key in habits) {
        if (input.includes(key)) {
            found = true;
            const list = document.createElement("ul");
            habits[key].forEach(habit => {
                const li = document.createElement("li");
                li.textContent = habit;
                list.appendChild(li);
            });
            output.appendChild(list);
        }
    }

    if (!found) {
        output.textContent = "Try entering 'focus', 'stress', or 'energy' to get started!";
    }
}
"""

# Save these files into a zip
from zipfile import ZipFile
import os

zip_path = "/mnt/data/NeuroPath2Success.zip"

with ZipFile(zip_path, 'w') as zipf:
    for filename, content in [("index.html", html_content), ("style.css", css_content), ("script.js", js_content)]:
        filepath = f"/mnt/data/{filename}"
        with open(filepath, "w") as file:
            file.write(content)
        zipf.write(filepath, arcname=filename)

